<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="90dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Work / Schedule"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Calendar Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Month Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivPrevMonth"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:rotation="180"
                        android:padding="4dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvCalendarMonthTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="May 2026"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivNextMonth"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_primary" />
                </RelativeLayout>

                <!-- Days of Week Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mon" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Tue" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wed" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Thu" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fri" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sat" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sun" android:textColor="@color/text_secondary" android:textSize="12sp" android:gravity="center" />
                </LinearLayout>

                <!-- Row 1: 27, 28, 29, 30, 1, 2, 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="27" android:textColor="@color/text_muted" android:textSize="13sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="28" android:textColor="@color/text_muted" android:textSize="13sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="29" android:textColor="@color/text_muted" android:textSize="13sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="30" android:textColor="@color/text_muted" android:textSize="13sp" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>

                <!-- Row 2: 4, 5, 6, 7, 8, 9, 10 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="10" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>

                <!-- Row 3: 11, 12, 13, 14, 15, 16, 17 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="11" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="12" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="13" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="14" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="15" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="16" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="17" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>

                <!-- Row 4: 18, 19, 20 (Solid Blue Circle), 21, 22, 23, 24 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="18" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="19" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    
                    <!-- Day 20 Active Blue Circle -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_today"
                            android:text="20"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                    </FrameLayout>

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="21" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="22" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="23" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="24" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>

                <!-- Row 5: 25, 26, 27, 28, 29, 30, 31 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="25" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="26" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="27" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="28" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="29" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="30" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="31" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>

                <!-- Calendar Legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Work Day -->
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_circle_today" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Work Day" android:textColor="@color/text_secondary" android:textSize="11sp" />

                    <!-- Completed -->
                    <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="14dp" android:background="@drawable/bg_pill_green" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Completed" android:textColor="@color/text_secondary" android:textSize="11sp" />

                    <!-- Day Off -->
                    <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="14dp" android:background="@color/cal_day_off" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Day Off" android:textColor="@color/text_secondary" android:textSize="11sp" />

                    <!-- Today -->
                    <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="14dp" android:background="@drawable/bg_circle_arrow" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Today" android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Timeline Section: May 20, 2026 (Today) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="May 20, 2026 (Today)"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider" />

        <!-- Timeline Item 1: Construction Site A -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <!-- Timeline Vertical Line & Node -->
            <View
                android:id="@+id/node1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_circle_today" />

            <View
                android:layout_width="1.5dp"
                android:layout_height="110dp"
                android:layout_below="@id/node1"
                android:layout_alignStart="@id/node1"
                android:layout_marginStart="4dp"
                android:background="@color/divider" />

            <!-- Content Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/node1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Construction Site A"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Upcoming Badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_pill_blue"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Upcoming"
                        android:textColor="@color/badge_upcoming_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="10:00 AM – 1:00 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Electrical Installation"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Supervisor: Arun Kumar"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Timeline Item 2: Warehouse Renovation -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <View
                android:id="@+id/node2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_circle_today" />

            <View
                android:layout_width="1.5dp"
                android:layout_height="110dp"
                android:layout_below="@id/node2"
                android:layout_alignStart="@id/node2"
                android:layout_marginStart="4dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/node2"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warehouse Renovation"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_pill_blue"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Upcoming"
                        android:textColor="@color/badge_upcoming_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2:00 PM – 5:00 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_briefcase"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Plumbing Work"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Supervisor: Irfan Ali"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Timeline Item 3: Site Office Work -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <View
                android:id="@+id/node3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_circle_today" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/node3"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Site Office Work"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_pill_blue"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Upcoming"
                        android:textColor="@color/badge_upcoming_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="5:30 PM – 6:30 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location_pin"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Documentation"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Supervisor: Suresh Babu"
                        android:textColor="@color/text_secondary"
