<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Center Content Wrapper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnTurnOnLocation"
        app:layout_constraintVertical_chainStyle="spread_inside"
        android:layout_marginTop="60dp">

        <!-- Circular Map & Pin Graphic -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_circle_avatar"
            android:backgroundTint="#EDF5FF"
            android:layout_marginBottom="36dp">

            <!-- Map Icon -->
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_map"
                app:tint="#B9D5FF" />

            <!-- Location Pin Icon overlay (offset slightly upwards) -->
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_location_pin"
                app:tint="#0052CC" />
        </FrameLayout>

        <!-- Heading -->
        <TextView
            android:id="@+id/tvWakeUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location is Off"
            android:textColor="#0F172A"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

        <!-- Subtext/Description -->
        <TextView
            android:id="@+id/tvSubtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Worker Tracker needs your location to automatically track your attendance and keep you safe."
            android:textColor="#475569"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.2"
            android:gravity="center" />

    </LinearLayout>

    <!-- Turn On Location Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTurnOnLocation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="40dp"
        android:text="Turn On Location"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:icon="@drawable/ic_location_pin"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#0052CC"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>