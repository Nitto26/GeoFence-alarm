<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Title and Geofence Pill -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/layoutGeofencePill"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWorksiteCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Worksite Title"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.01"
                    tools:text="Electrical Installation - Site A" />

                <TextView
                    android:id="@+id/tvWorksiteCardRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Assigned Task"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:letterSpacing="0.01"
                    tools:text="Primary Electrical Wiring" />
            </LinearLayout>

            <!-- Geofence Badge Pill -->
            <LinearLayout
                android:id="@+id/layoutGeofencePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_pill_blue"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_circle_today"
                    android:backgroundTint="#2563EB" />

                <TextView
                    android:id="@+id/tvWorksiteRadiusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="500m"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="500m" />
            </LinearLayout>
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#F1F5F9" />

        <!-- Details List -->
        <!-- 1. Timing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                app:tint="#2563EB" />

            <TextView
                android:id="@+id/tvWorksiteTiming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="08:00 AM - 05:00 PM (Mon-Fri)"
                android:textColor="#1E293B"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:letterSpacing="0.01"
                tools:text="08:00 AM - 05:00 PM (Mon-Fri)" />
        </LinearLayout>

        <!-- 2. Supervisor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_person"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tvWorksiteSupervisor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Supervisor: —"
                android:textColor="#475569"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:letterSpacing="0.01"
                tools:text="Supervisor: Arun Kumar" />
        </LinearLayout>

        <!-- 3. Coordinates / Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location_pin"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tvWorksiteCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Location: —"
                android:textColor="#64748B"
                android:textSize="12.5sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:letterSpacing="0.01"
                tools:text="Location: 28.6139, 77.2090" />
        </LinearLayout>

        <!-- Bottom Action: View On Map Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCardViewOnMap"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="View Worksite on Map"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:letterSpacing="0.02"
                app:backgroundTint="#2563EB"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_map"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:elevation="0dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
