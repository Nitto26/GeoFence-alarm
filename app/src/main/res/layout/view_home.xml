<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/mainHomeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="100dp">

            <!-- Top Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/ivRefreshData"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHomeGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Morning,"
                        android:textColor="#64748B"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHomeUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Worker"
                        android:textColor="#0F172A"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Deepak Sharma" />

                    <!-- Date Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#64748B" />

                        <TextView
                            android:id="@+id/tvHomeDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Thu, 16 Oct 2025"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            tools:text="Thu, 16 Oct 2025" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Top Right Standard Universal Refresh Button -->
                <ImageView
                    android:id="@+id/ivRefreshData"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_refresh_standard"
                    android:contentDescription="Refresh Data" />
            </RelativeLayout>

            <!-- 1. TOP SECTION: PAYROLL CARD WITH DYNAMIC WORKING HOURS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:id="@+id/btnHeroPayroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_blue"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:baselineAligned="false">

                    <!-- Left Half: Monthly Payroll -->
                    <LinearLayout
                        android:id="@+id/layoutPayrollSection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Translucent Wallet Icon -->
                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_circle_wallet">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_wallet"
                                    app:tint="#FFFFFF" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvPayrollPeriodLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Monthly Payroll"
                                    android:textColor="#D0E1FD"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvPayrollAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="—"
                                    android:textColor="#FFFFFF"
                                    android:textSize="21sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Growth / Status Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_arrow_trend_up" />

                            <TextView
                                android:id="@+id/tvPayrollBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="Pending server approval"
                                android:textColor="#BAF7D0"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Subtle Vertical Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginHorizontal="10dp"
                        android:background="#33FFFFFF" />

                    <!-- Right Half: Worked Hours (Updates dynamically with Clock In/Out) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_clock"
                                app:tint="#D0E1FD" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Worked Hours"
                                android:textColor="#D0E1FD"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHoursWorkedTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <!-- Timeframe Pill Dropdown (Defaults to Today) -->
                        <LinearLayout
                            android:id="@+id/btnMonthDropdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_pill_hero"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvMonthFilterLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today ∨"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. WORKSITES STACKED SWIPING CARDS (ASSIGNED WORKSITES TILE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Header Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location_pin_base" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Assigned Worksites"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Worksites Count Badge -->
                        <TextView
                            android:id="@+id/tvWorksitesCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill_blue"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="0 Sites"
                            android:textColor="#2563EB"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnViewAllWorksitesOnMap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:text="View on Map &gt;"
                        android:textColor="#2563EB"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Stacked Swiping Cards ViewPager2 Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerWorksites"
                        android:layout_width="match_parent"
                        android:layout_height="275dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="4dp"
                        android:paddingEnd="50dp" />

                    <!-- Empty State Placeholder when no worksites are assigned -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardWorksiteEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="265dp"
                        android:layout_margin="4dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="1dp"
                        app:cardBackgroundColor="#F8FAFC"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="28dp">

                            <ImageView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="#94A3B8" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="No Worksites Assigned"
                                android:textColor="#0F172A"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.01" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginHorizontal="12dp"
                                android:text="You have no workspace assigned for today. You are currently on standby."
                                android:textColor="#64748B"
                                android:textSize="13.5sp"
                                android:gravity="center"
                                android:lineSpacingExtra="5dp"
                                android:lineSpacingMultiplier="1.2"
                                android:letterSpacing="0.01" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <!-- Carousel Dot Indicators -->
                <LinearLayout
                    android:id="@+id/llCarouselDots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- 3. UNDER ASSIGNED WORKSITES: WORK TIME CONTROL CARD (WORK TIME STARTED / ENDED) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardClockControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Status Header Row with Live Digital Clock -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivAttendanceIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#64748B" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAttendanceStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Work Time Ended"
                                android:textColor="#64748B"
                                android:textSize="15.5sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.01"
                                tools:text="Work Time Ended" />

                            <TextView
                                android:id="@+id/tvAttendanceSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="App is sleeping • No background tracking"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:lineSpacingExtra="2dp"
                                android:letterSpacing="0.01" />
                        </LinearLayout>

                        <!-- Live Digital Clock Display -->
                        <TextView
                            android:id="@+id/tvLiveCurrentTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09:30:15 PM"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Clock In / Clock Out Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClockToggle"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:text="Clock In"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:backgroundTint="#2563EB"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_clock"
                        app:iconTint="#FFFFFF"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:elevation="0dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Hidden / Backwards-Compatibility Views to preserve code references without breaking -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <TextView android:id="@+id/tvHomeTallyNo" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvWorksitesCountToday" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvHoursWorkedLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvNextWorksiteTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvNextWorksiteTime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvNextWorksiteRole" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvNextSupervisor" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/layoutSyncBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <View android:id="@+id/viewSyncStatusDot" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvSyncBadgeText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnGoToMap" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/btnViewOnMapLink" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/btnNextWorksiteArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/btnQuickPayroll" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/btnQuickViewMap" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/btnQuickClockToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvQuickClockText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/ivQuickClockIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/btnScheduleViewAll" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <FrameLayout android:id="@+id/cardTodaySchedule" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/llScheduleEmptyState" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/llScheduleActiveState" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
